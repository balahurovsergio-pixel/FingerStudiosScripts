-- -------------------- CORE AUTOMATION FUNCTIONS --------------------

-- 1. Day Multiplier (speeds up time)
local function advanceDay()
    -- Many games use Lighting.ClockTime or a custom TimeOfDay
    -- We'll quickly cycle 24 hours * multiplier
    local multiplier = CONFIG.DayMultiplier
    local currentDay = stats.Day
    for i = 1, multiplier do
        -- increment time by 24/multiplier hours
        local newTime = (Lighting.ClockTime + (24 / multiplier)) % 24
        Lighting.ClockTime = newTime
        -- also try common alternative
        local minutesAfter = Lighting:GetMinutesAfterMidnight()
        Lighting:SetMinutesAfterMidnight((minutesAfter + (1440 / multiplier)) % 1440)
        wait(0.01) -- fast iteration, adjust for performance
    end
    stats.Day = stats.Day + multiplier
    if stats.Day > stats.MaxDay then stats.Day = stats.MaxDay end
end

-- 2. Auto upgrade campfire to max level
local function upgradeCampfire()
    local campfire = Workspace:FindFirstChild("Campfire") or Workspace:FindFirstChild("Firepit")
    if not campfire then return end
    local currentLevel = campfire:FindFirstChild("Level")
    if currentLevel and currentLevel.Value >= CONFIG.CampfireMaxLevel then return end

    -- Interact with upgrade button or add fuel repeatedly
    for i = 1, CONFIG.CampfireMaxLevel do
        local upgradePart = campfire:FindFirstChild("UpgradePart") or campfire:FindFirstChild("Upgrade")
        if upgradePart then
            interactWithPart(upgradePart)
            wait(0.5)
        else
            -- Alternative: use fuel items
            local fuelItem = "Wood" or "Log"
            equipItem(fuelItem)
            wait(0.3)
            -- Fire event if needed
            local args = { [1] = "AddFuel" }
            local remote = ReplicatedStorage:FindFirstChild("CampfireEvent")
            if remote then remote:FireServer(unpack(args)) end
            wait(0.3)
        end
    end
end

-- 3. Auto scrap broken items into iron
local function scrapBrokenItems()
    local scrapStation = Workspace:FindFirstChild(CONFIG.ScrapToolName)
    if not scrapStation then return end

    -- Find broken items in inventory
    local brokenItems = {}
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("broken") or tool.Name:lower():find("damaged")) then
            table.insert(brokenItems, tool)
        end
    end
    if #brokenItems == 0 then return end

    -- Equip each and interact with scrap station
    for _, tool in ipairs(brokenItems) do
        equipItem(tool.Name)
        wait(0.2)
        teleportTo(scrapStation.Position + Vector3.new(0,2,0))
        wait(0.3)
        interactWithPart(scrapStation)
        wait(0.5)
    end
end

-- 4. Teleport to save missing children & "unstore" (rescue)
local function rescueChildren()
    local childNPCs = Workspace:FindFirstChild("MissingChildren") or Workspace:FindFirstChild("ChildrenInCages")
    if not childNPCs then return end

    for _, location in ipairs(CONFIG.MissingChildrenLocations) do
        teleportTo(location)
        wait(0.5)

        -- Look for a child NPC or cage within 20 studs
        local found = nil
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj.Name:lower():find("child") and (obj.PrimaryPart and (obj.PrimaryPart.Position - location).Magnitude < 20) then
                found = obj
                break
            end
        end
        if found then
            -- "unstore" by clicking a release button or interacting
            local releasePart = found:FindFirstChild("Release") or found:FindFirstChild("Unstore")
            if releasePart then
                interactWithPart(releasePart)
                wait(0.5)
                stats.ChildrenRescued = stats.ChildrenRescued + 1
            end
        end
    end
end

-- 5. Auto build bed blueprints
local function buildBeds()
    local blueprint = Workspace:FindFirstChild(CONFIG.BedBlueprintName)
    if not blueprint then return end

    -- Check if we have a hammer
    equipItem(CONFIG.HammerName)
    wait(0.3)

    -- Hit the blueprint (build) multiple times
    local buildPart = blueprint:FindFirstChild("Handle") or blueprint.PrimaryPart
    if buildPart then
        teleportTo(buildPart.Position + Vector3.new(0,2,0))
        wait(0.3)
        for i = 1, 10 do
            -- simulate hitting
            local remote = ReplicatedStorage:FindFirstChild("BuildEvent")
            if remote then remote:FireServer(buildPart) end
            interactWithPart(buildPart)
            wait(0.2)
        end
    end
end

-- 6. Open chests at children rescue locations
local function openChests()
    for _, location in ipairs(CONFIG.MissingChildrenLocations) do
        for _, chest in ipairs(Workspace:GetDescendants()) do
            if chest:IsA("Model") and table.find(CONFIG.ChestNames, chest.Name) then
                if (chest.PrimaryPart and (chest.PrimaryPart.Position - location).Magnitude < 30) then
                    teleportTo(chest.PrimaryPart.Position + Vector3.new(0,2,0))
                    wait(0.3)
                    interactWithPart(chest.PrimaryPart)
                    wait(0.5)
                end
            end
        end
    end
end

-- 7. Hunger management: cook and eat
local function manageHunger()
    local hunger = getStatValue("Hunger")
    if hunger >= CONFIG.HungerThreshold then return end

    -- Teleport to campfire
    local campfire = Workspace:FindFirstChild("Campfire") or Workspace:FindFirstChild("Firepit")
    if not campfire then return end
    teleportTo(campfire.Position + Vector3.new(0,2,0))
    wait(0.5)

    -- Cook each food type if available
    for foodKey, foodName in pairs(CONFIG.FoodItems) do
        if hasItem(foodName) then
            equipItem(foodName)
            wait(0.3)
            -- Interact with campfire to cook
            interactWithPart(campfire) -- assume clicking campfire with food cooks it
            wait(0.5)
            -- The cooked version might appear; eat it
            -- Simple approach: use a remote to cook
            local cookRemote = ReplicatedStorage:FindFirstChild("CookFood")
            if cookRemote then
                cookRemote:FireServer(foodName)
            end
            wait(0.3)
            -- Now eat the cooked item (often same name or with "Cooked" prefix)
            local cookedName = "Cooked " .. foodName
            local itemToEat = cookedName
            if not hasItem(itemToEat) then
                itemToEat = foodName -- fallback
            end
            equipItem(itemToEat)
            wait(0.2)
            -- simulate eating (activate tool)
            local tool = equipItem(itemToEat)
            if tool then
                tool:Activate()
                wait(0.3)
            end
        end
    end
end

-- 8. Auto farming (basic resource gathering)
local function autoFarm()
    -- Chop trees
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:lower():find("tree") or obj.Name:lower():find("log")) then
            local trunk = obj:FindFirstChild("Trunk") or obj.PrimaryPart
            if trunk then
                teleportTo(trunk.Position + Vector3.new(0,2,0))
                wait(0.2)
                -- Equip axe if present
                equipItem("Axe")
                wait(0.2)
                -- hit
                local remote = ReplicatedStorage:FindFirstChild("Harvest")
                if remote then remote:FireServer(obj) end
                interactWithPart(trunk)
                wait(0.1)
            end
        end
    end

    -- Mine rocks
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:lower():find("rock") or obj.Name:lower():find("boulder")) then
            local rockPart = obj.PrimaryPart
            if rockPart then
                teleportTo(rockPart.Position + Vector3.new(0,2,0))
                equipItem("Pickaxe")
                wait(0.2)
                local remote = ReplicatedStorage:FindFirstChild("Harvest")
                if remote then remote:FireServer(obj) end
                interactWithPart(rockPart)
                wait(0.1)
            end
        end
    end

    -- Gather berries
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():find("berrybush") then
            local bushPart = obj.PrimaryPart
            if bushPart then
                teleportTo(bushPart.Position + Vector3.new(0,2,0))
                wait(0.2)
                interactWithPart(bushPart)
                wait(0.1)
            end
        end
    end
end

-- 9. Auto revive with bandages
local function autoRevive()
    if humanoid.Health <= 0 then
        wait(1) -- brief delay after death
        if hasItem(CONFIG.BandageName) then
            equipItem(CONFIG.BandageName)
            wait(0.2)
            local tool = equipItem(CONFIG.BandageName)
            if tool then
                tool:Activate()
                wait(0.5)
            end
        end
        -- wait for revival
        repeat wait(0.5) until humanoid.Health > 0
    end
end

-- -------------------- MAIN LOOP --------------------
local updateStatsGUI = createStatsGUI()

-- Primary task scheduler
local function main()
    while stats.Day < stats.MaxDay do
        -- Status update
        updateStatsGUI()

        -- Health/Revive check (highest priority)
        autoRevive()

        -- Day multiplier to advance time
        advanceDay()

        -- Critical tasks
        upgradeCampfire()
        scrapBrokenItems()
        rescueChildren()
        buildBeds()
        openChests()

        -- Hunger management (may interrupt other tasks)
        manageHunger()

        -- General farming
        autoFarm()

        -- Small yield to prevent freezing
        wait(1)
    end

    -- Final state
    updateStatsGUI()
    print("Day 1000 reached! Automation complete.")
end

-- Start in a protected coroutine
local success, err = pcall(main)
if not success then
    warn("Script error: " .. tostring(err))
end
