-- Utility functions
local function wait(seconds)
    task.wait(seconds)
end

local function findFirstChild(parent, name)
    for _, child in ipairs(parent:GetChildren()) do
        if child.Name == name then
            return child
        end
    end
    return nil
end

local function getItemCount(itemName)
    local count = 0
    -- Check backpack
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.Name == itemName then
            count = count + 1
        end
    end
    -- Check character
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") and tool.Name == itemName then
                count = count + 1
            end
        end
    end
    return count
end

local function hasItem(itemName)
    return getItemCount(itemName) > 0
end

local function equipItem(itemName)
    local tool = findFirstChild(backpack, itemName)
    if not tool and character then
        tool = findFirstChild(character, itemName)
    end
    if tool and tool:IsA("Tool") then
        if tool.Parent ~= character then
            -- move to character if possible
            tool.Parent = character
        end
        -- attempt to activate
        if tool:FindFirstChild("Handle") then
            -- some games require the tool to be equipped before use
            humanoid:EquipTool(tool)
        end
        return tool
    end
    return nil
end

local function getStatValue(statName)
    -- Generic function to read player stats (e.g., Hunger, Health)
    -- Adjust depending on the game's stat system.
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local stat = leaderstats:FindFirstChild(statName)
        if stat and stat:IsA("NumberValue") or stat:IsA("IntValue") then
            return stat.Value
        end
    end
    -- Fallback: try player direct children
    local s = player:FindFirstChild(statName)
    if s and (s:IsA("NumberValue") or s:IsA("IntValue")) then
        return s.Value
    end
    -- If "Hunger" is a property of humanoid (in some games)
    if statName == "Hunger" and humanoid:FindFirstChild("Hunger") then
        return humanoid.Hunger.Value
    end
    return 100 -- default
end

local function teleportTo(position)
    if character and character:FindFirstChild("HumanoidRootPart") then
        character.HumanoidRootPart.CFrame = CFrame.new(position)
    end
end

local function interactWithPart(part)
    -- Simulate clicking / proximity prompt
    if part:FindFirstChildWhichIsA("ProximityPrompt") then
        local prompt = part:FindFirstChildWhichIsA("ProximityPrompt")
        if prompt.Enabled then
            fireproximityprompt(prompt)
            wait(0.5)
        end
    elseif part:FindFirstChild("ClickDetector") then
        fireclickdetector(part.ClickDetector)
        wait(0.2)
    end
end

